summary(Power_Hometemp)
perform_regression_coef <- function(data, formula_str) {
lm_model <- lm(as.formula(formula_str), data = data)
# Get the coefficients of the model
coefficients <- coef(lm_model)
# Get the p-value, f-statistic, and multiple R-squared of the model
p_value <- summary(lm_model)$coefficients[2, 4]
f_statistic <- summary(lm_model)$fstatistic[1]
multiple_r_squared <- summary(lm_model)$adj.r.squared
# Append the results and model information to a dataframe
result <- data.frame(
p_value = p_value,
f_statistic = f_statistic,
multiple_r_squared = multiple_r_squared
)
return(result)
}
perform_regression <- function(data, formula_str) {
lm_model <- lm(as.formula(formula_str), data = data)
summary_stats <- summary(lm_model)
plot_lm <- plot(lm_model)
result <- list(lm_model = lm_model, summary_stats = summary_stats, plot_lm = plot_lm)
return(result)
}
coefficients_to_equation <- function(model) {
co <- round(model$coefficients, 2)
eq <- c()
for(i in 1:length(co)) {
if (i == 1) {
eq <- paste(eq, co[i], sep = "")
} else {
if (co[i] > 0) {
eq <- paste(eq, paste("+ ", round(exp(co[i]), 3), " ", names(co[i]), sep = ""))
} else {
eq <- paste(eq, paste("+ ", round(exp(co[i]), 3), " ", names(co[i]), sep = ""))
}
}
}
return(eq)
}
